# Happy Zero Cinnamon Desktop Settings
# Enhanced defaults for Cinnamon UI (complementary to GNOME)

[org/cinnamon]
# Panel configuration
panels-enabled=['1:0:bottom']
panels-height=['1:40']
panels-autohide=false

# Menu configuration
enabled-applets=['panel1:left:0:menu@cinnamon.org:1', 'panel1:left:1:separator@cinnamon.org:2', 'panel1:left:2:grouped-window-list@cinnamon.org:3', 'panel1:right:0:systray@cinnamon.org:4', 'panel1:right:1:xapp-status@cinnamon.org:5', 'panel1:right:2:notifications@cinnamon.org:6', 'panel1:right:3:removable-drives@cinnamon.org:7', 'panel1:right:4:network@cinnamon.org:8', 'panel1:right:5:power@cinnamon.org:9', 'panel1:right:6:calendar@cinnamon.org:10', 'panel1:right:7:sound@cinnamon.org:11', 'panel1:right:8:show-desktop@cinnamon.org:12']

# Theme settings
desktop-effects=false
enable-indicators=true

[org/cinnamon/desktop/interface]
gtk-theme='Yaru'
icon-theme='Yaru'
cursor-theme='Yaru'
font-name='Ubuntu 11'
document-font-name='Ubuntu 11'
monospace-font-name='Ubuntu Mono 11'

[org/cinnamon/desktop/wm/preferences]
button-layout='close,minimize,maximize:menu'
theme='Yaru'
titlebar-font='Ubuntu Bold 11'
num-workspaces=4

[org/cinnamon/desktop/background]
picture-options='zoom'
primary-color='#1A9C89'
secondary-color='#147A6B'

[org/cinnamon/desktop/screensaver]
picture-options='zoom'
primary-color='#1A9C89'
secondary-color='#147A6B'

[org/cinnamon/theme]
name='Yaru'

[org/cinnamon/muffin]
tile-hud-threshold=25
workspaces-only-on-primary=false

[org/cinnamon/desktop/keybindings]
show-desklets=@as []

[org/cinnamon/settings-daemon/peripherals/touchpad]
natural-scroll=true
tap-to-click=true
disable-while-typing=true
