# Happy Zero Calamares Branding

componentName:   happyzero
welcomeStyleCalamares: true
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 800px,520px
windowPlacement: center

strings:
    productName:         Happy Zero
    shortProductName:    HZ
    version:             1.0
    shortVersion:        1.0
    versionedName:       Happy Zero 1.0 "Noble Zero"
    shortVersionedName:  HZ 1.0
    bootloaderEntryName: Happy Zero
    productUrl:          https://happyzero.org
    supportUrl:          https://happyzero.org/support
    knownIssuesUrl:      https://github.com/happyzero/happy-zero/issues
    releaseNotesUrl:     https://happyzero.org/release-notes

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
slideshowAPI: 2

style:
    sidebarBackground:   "#1E1E1E"
    sidebarText:         "#F1F3F4"
    sidebarTextSelect:   "#22D3EE"
    sidebarTextHighlight:"#1A9C89"
    windowBackground:    "#F8F9FA"
    windowText:          "#1F1F1F"
    windowTextSelect:    "#147A6B"
    windowTextHighlight: "#1A9C89"
    navigationBackground:"#2D2D2D"
    navigationText:      "#F1F3F4"
    navigationTextSelect:"#22D3EE"
    navigationTextHighlight:"#1A9C89"
